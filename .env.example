# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. See docs/GEMINI-INTEGRATION.md and
# docs/SPOTIFY-INTEGRATION.md for setup details on each of these.

# ── Google Cloud / Firestore / Vertex AI (Gemini) ───────────────────────────
# REQUIRED — lib/gcp.ts throws on startup if this is unset. There is no
# hardcoded fallback project on purpose: ADC in most dev environments (this
# sandbox included) has real access to whatever project you name here, so an
# unset/wrong value can silently read AND WRITE real data in that project.
#
# For local development, either:
#   (a) point this at a real project you deliberately intend to use, or
#   (b) run `npm run emulators` and set FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#       and FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 so nothing touches
#       real data at all — this is the safe default for iterating on features.
# `gcloud auth application-default login` first if using a real project.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional, defaults to global.
GOOGLE_CLOUD_LOCATION=global

# Optional, defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# REQUIRED — lib/gcp.ts throws if unset. GCS bucket for .cho backups.
JAMSHELF_STORAGE_BUCKET=your-songs-bucket

# ── Spotify (track preview / embed) ─────────────────────────────────────────
# Optional — Spotify matching is silently skipped if unset. Create a free app
# at https://developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Dev tooling ──────────────────────────────────────────────────────────────
# Optional. Only used by scripts/build-default-songs.mjs to point at a local
# directory of .cho files when regenerating lib/data/default-songs.ts.
CHORDS_DIR=
